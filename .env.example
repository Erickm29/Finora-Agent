# Server
PORT=3001
NODE_ENV=development
USE_MEMORY_STORE=true
# local = grammY long polling; production = webhook
TELEGRAM_MODE=local
PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot (grammY)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Gemini (Google AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# On free-tier 429 the API retries then falls back to local heuristic mentor.

# Integrations (Paso 7)
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Wallbit: leave empty until account/funds exist (confirm stays stub)
WALLBIT_API_KEY=
WALLBIT_API_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Zavu (optional / secondary)
ZAVU_API_KEY=

# Next.js (apps/web) — same Supabase + API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=FinoraBot
