# Server
PORT=3001
NODE_ENV=development
USE_MEMORY_STORE=true
# local = grammY long polling; production = webhook
TELEGRAM_MODE=local
PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot (grammY)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI providers (HA layer — order in apps/api/config/ai-providers.json)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_PROVIDER=groq
# AI_PROVIDERS_CONFIG=apps/api/config/ai-providers.json

# Integrations (Paso 7)
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Wallbit: leave empty until account/funds exist (confirm stays stub)
WALLBIT_API_KEY=
WALLBIT_API_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Zavu (optional / secondary)
ZAVU_API_KEY=

# Vite dashboard (apps/web) — copy also to apps/web/.env
# VITE_API_URL=http://localhost:3001/v1
# VITE_USE_MOCKS=true
