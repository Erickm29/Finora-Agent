# Base URL of the Backend + Agente IA API (FastAPI). Never hardcode this in source.
VITE_API_URL=http://localhost:8000

# When "true" (default), the app runs entirely against the in-memory mock layer
# (src/mocks) — no backend required. Set to "false" once the real endpoints from the
# Backend team are ready; no component code needs to change, only this flag.
VITE_USE_MOCKS=true
