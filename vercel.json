{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -w @finora/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://finora-api-taym.onrender.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://finora-api-taym.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
