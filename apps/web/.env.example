# Base URL of the Finora Hono API (include /v1 prefix).
VITE_API_URL=http://localhost:3001/v1

# When "true" (default), the app runs entirely against the in-memory mock layer
# (src/mocks) — no backend required. Set to "false" to consume the real API.
VITE_USE_MOCKS=true

# Producción (Vercel): apuntá a la API en Render y desactivá mocks.
# VITE_API_URL=https://finora-api.onrender.com/v1
# VITE_USE_MOCKS=false
# Ver docs/context/deploy.md
